{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixcut.invalid/schemas/clip.schema.json",
  "title": "clip",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entity": {
      "const": "clip"
    },
    "is_fixture": {
      "type": "boolean"
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "goods_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_type": {
      "enum": [
        "product_shot",
        "livestream_clip",
        "other"
      ]
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "object",
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "action": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "shot_size": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "risk": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "content",
        "action",
        "shot_size",
        "risk"
      ],
      "additionalProperties": false
    },
    "usable_start_sec": {
      "type": "number",
      "minimum": 0
    },
    "usable_end_sec": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "rights_confirmed": {
      "type": "boolean"
    },
    "review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "enum": [
                "feishu",
                "local_manual",
                "fixture"
              ]
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "approved_content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "actor_id",
            "channel",
            "approved_at",
            "approved_content_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "entity",
    "is_fixture",
    "clip_id",
    "revision",
    "source_id",
    "brand_id",
    "goods_id",
    "source_type",
    "taxonomy_version",
    "tags",
    "usable_start_sec",
    "usable_end_sec",
    "description",
    "review_status",
    "content_sha256",
    "approval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object"
          },
          "brand_id": {
            "type": "string",
            "minLength": 1
          },
          "goods_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
