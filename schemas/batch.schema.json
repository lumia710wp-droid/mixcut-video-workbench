{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixcut.invalid/schemas/batch.schema.json",
  "title": "batch",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entity": {
      "const": "batch"
    },
    "is_fixture": {
      "type": "boolean"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "goods_id": {
      "type": "string",
      "minLength": 1
    },
    "task_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "target_min_frames": {
      "type": "integer",
      "minimum": 1
    },
    "target_max_frames": {
      "type": "integer",
      "minimum": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "audio_mode": {
      "enum": [
        "tts_uniform",
        "provided_voice",
        "music_only"
      ]
    }
  },
  "required": [
    "schema_version",
    "entity",
    "is_fixture",
    "batch_id",
    "brand_id",
    "goods_id",
    "task_count",
    "task_ids",
    "target_min_frames",
    "target_max_frames",
    "snapshot_sha256",
    "seed",
    "audio_mode"
  ],
  "additionalProperties": false
}
