{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixcut.invalid/schemas/edit_plan.schema.json",
  "title": "edit_plan",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entity": {
      "const": "edit_plan"
    },
    "is_fixture": {
      "type": "boolean"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "goods_id": {
      "type": "string",
      "minLength": 1
    },
    "script_revision": {
      "type": "integer",
      "minimum": 1
    },
    "script_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "product_revision": {
      "type": "integer",
      "minimum": 1
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "build_id": {
      "type": "string",
      "pattern": "^b_[a-f0-9]{16,64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_mode": {
      "enum": [
        "tts_uniform",
        "provided_voice",
        "music_only"
      ]
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "const": 1080
        },
        "height": {
          "const": 1920
        },
        "fps_num": {
          "const": 30
        },
        "fps_den": {
          "const": 1
        }
      },
      "required": [
        "width",
        "height",
        "fps_num",
        "fps_den"
      ],
      "additionalProperties": false
    },
    "total_frames": {
      "type": "integer",
      "minimum": 1
    },
    "style_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "media_id": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "working_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "total_frames": {
            "type": "integer",
            "minimum": 1
          },
          "fps_num": {
            "const": 30
          },
          "fps_den": {
            "const": 1
          },
          "time_mapping": {
            "enum": [
              "identity_cfr",
              "full_timeline_cfr_zero_origin"
            ]
          }
        },
        "required": [
          "media_id",
          "source_id",
          "source_sha256",
          "working_sha256",
          "root_id",
          "relative_path",
          "total_frames",
          "fps_num",
          "fps_den",
          "time_mapping"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "clip_id": {
            "type": "string",
            "minLength": 1
          },
          "clip_revision": {
            "type": "integer",
            "minimum": 1
          },
          "media_id": {
            "type": "string",
            "minLength": 1
          },
          "source_in_frame": {
            "type": "integer",
            "minimum": 0
          },
          "source_out_frame": {
            "type": "integer",
            "minimum": 1
          },
          "timeline_start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "source_audio_gain": {
            "const": 0
          },
          "speed": {
            "const": 1
          },
          "fit_mode": {
            "enum": [
              "contain",
              "cover"
            ]
          },
          "crop": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "approval_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height",
                  "approval_sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "shot_id",
          "clip_id",
          "clip_revision",
          "media_id",
          "source_in_frame",
          "source_out_frame",
          "timeline_start_frame",
          "duration_frames",
          "source_audio_gain",
          "speed",
          "fit_mode",
          "crop",
          "selection_reason"
        ],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 6
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "shot_id",
          "start_frame",
          "end_frame",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "audio_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "track_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "voiceover",
              "bgm"
            ]
          },
          "root_id": {
            "type": "string",
            "minLength": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "rights_confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "track_id",
          "role",
          "root_id",
          "relative_path",
          "sha256",
          "start_frame",
          "duration_frames",
          "gain"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "entity",
    "is_fixture",
    "task_id",
    "batch_id",
    "brand_id",
    "goods_id",
    "script_revision",
    "script_sha256",
    "product_revision",
    "taxonomy_version",
    "snapshot_sha256",
    "build_id",
    "plan_sha256",
    "audio_mode",
    "canvas",
    "total_frames",
    "style_sha256",
    "media",
    "shots",
    "captions",
    "audio_tracks"
  ],
  "additionalProperties": false
}
