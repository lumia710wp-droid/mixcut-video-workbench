{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mixcut.invalid/schemas/product.schema.json",
  "title": "product",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "entity": {
      "const": "product"
    },
    "is_fixture": {
      "type": "boolean"
    },
    "brand_id": {
      "type": "string",
      "minLength": 1
    },
    "goods_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "allowed_text": {
            "type": "string",
            "minLength": 1
          },
          "evidence_note": {
            "type": "string",
            "minLength": 1
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "claim_id",
          "allowed_text",
          "evidence_note",
          "valid_until"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "forbidden_phrases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "review_status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "stale"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "actor_id": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "enum": [
                "feishu",
                "local_manual",
                "fixture"
              ]
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "approved_content_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "actor_id",
            "channel",
            "approved_at",
            "approved_content_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "entity",
    "is_fixture",
    "brand_id",
    "goods_id",
    "revision",
    "name",
    "claims",
    "forbidden_phrases",
    "review_status",
    "content_sha256",
    "approval"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "properties": {
          "approval": {
            "type": "object"
          }
        }
      }
    }
  ]
}
